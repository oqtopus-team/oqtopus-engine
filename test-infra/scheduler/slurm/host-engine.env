export OQTOPUS_ENGINE_ROOT="${OQTOPUS_ENGINE_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)}"
export PATH="${OQTOPUS_ENGINE_ROOT}/test-infra/scheduler/slurm/host-cli:${PATH}"
export SLURM_PARTITION="${SLURM_PARTITION:-intelsv}"
export SLURM_DEVICE_ID="${SLURM_DEVICE_ID:-qulacs}"
export SLURM_DEVICE_N_QUBITS="${SLURM_DEVICE_N_QUBITS:-16}"
export SLURM_WORK_ROOT="${SLURM_WORK_ROOT:-${OQTOPUS_ENGINE_ROOT}/.cache/oqtopus-slurm-work}"
export SLURM_BATCH_SCRIPT="${SLURM_BATCH_SCRIPT:-${OQTOPUS_ENGINE_ROOT}/test-infra/scheduler/slurm/run_qulacs_mpi_job.sh}"
export SLURM_WORKER_SCRIPT="${SLURM_WORKER_SCRIPT:-${OQTOPUS_ENGINE_ROOT}/core/slurm_resources/run_qulacs_mpi.py}"
export JOB_REPOSITORY_URL="${JOB_REPOSITORY_URL:-http://localhost:8888}"
export DEVICE_REPOSITORY_URL="${DEVICE_REPOSITORY_URL:-http://localhost:8888}"
export JOB_REPOSITORY_API_KEY="${JOB_REPOSITORY_API_KEY:-}"
export DEVICE_REPOSITORY_API_KEY="${DEVICE_REPOSITORY_API_KEY:-}"
export TRANQU_ADDRESS="${TRANQU_ADDRESS:-127.0.0.1:52020}"
export SLURM_QUBITS_PER_NODE="${SLURM_QUBITS_PER_NODE:-30}"
export SLURM_POLL_INTERVAL_SECONDS="${SLURM_POLL_INTERVAL_SECONDS:-5}"
export JOB_FETCHER_INTERVAL_SECONDS="${JOB_FETCHER_INTERVAL_SECONDS:-10}"
